# ==========================================
# Aurevix Echo - Git Ignore
# ==========================================

# Build directories
/build/
/build-*/
/cmake-build-*/
/out/
/Debug/
/Release/
/x64/
/x86/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
compile_commands.json
CMakeUserPresets.json

# Compiled binaries and libraries
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.obj
*.o
*.pdb
*.ilk
*.exp
*.pch
*.idb
*.ipch
*.class

# Debug and profiling output
*.log
*.dmp
*.stackdump
*.prof
*.profraw
*.gcda
*.gcno

# Visual Studio
.vs/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
ipch/

# JetBrains IDEs
.idea/
*.iml

# VS Code workspace settings
.vscode/
!.vscode/extensions.json

# Qt Creator
*.pro.user
*.pro.user.*
*.qbs.user
CMakeLists.txt.user
CMakeLists.txt.user.*

# Ninja
.ninja_deps
.ninja_log

# Package managers and generated dependencies
/vcpkg_installed/
/conan/
/conanbuild/
/conanhome/
/_conan_*/

# Local databases and application data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary files
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo
*~

# Local application state
/user-data/
/local-data/
/data/
/logs/